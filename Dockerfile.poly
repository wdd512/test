FROM oven/bun:1-debian

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY . .

WORKDIR /app/Poly

RUN bun install --frozen-lockfile

ENV BTC_AGENT_ROOT=/app
ENV BTC_AGENT_PYTHON=python3
ENV BTC_AGENT_SYMBOL=BTC-USD
ENV BTC_AGENT_INTERVAL=5m
ENV BTC_AGENT_MODEL=btc_candle_direction_model.json
ENV BTC_AGENT_THRESHOLD=0.52
ENV BTC_AGENT_FLIP_THRESHOLD=0.535
ENV MARKET_DATA_PROVIDER=coinbase
ENV WALLET_BALANCE=100
ENV POLY_MODEL_SHARES=5
ENV POLY_MODEL_POLL_MS=10000
ENV POLY_MODEL_MIN_CONFIDENCE=0.535
ENV POLY_MODEL_FLIP_CONFIDENCE=0.58
ENV POLY_MODEL_MAX_ASK=0.68
ENV POLY_MODEL_MIN_LIQUIDITY=1
ENV POLY_MODEL_MIN_REMAINING_SEC=20
ENV POLY_ROUNDS=60

CMD ["sh", "-c", "bun run index.ts --strategy ml-signal --rounds ${POLY_ROUNDS} --always-log"]
